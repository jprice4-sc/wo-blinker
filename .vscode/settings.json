{
    "liveServer.settings.root": "site/",
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff", // cSpell:ignore charliermarsh
        "editor.formatOnSave": true,
        "editor.formatOnSaveMode": "file",
        "editor.formatOnType": false,
        "editor.codeActionsOnSave": {
            "source.fixAll.ruff": "explicit",
            "source.organizeImports.ruff": "explicit"
        }
    },
    "python.languageServer": "Pylance",
    "editor.formatOnSave": true,
    "autoDocstring.docstringFormat": "google-notypes",
    // Ruff should be able to find ruff.toml, but in case user settings specify something else
    "ruff.configuration": "${workspaceFolder}/ruff.toml",
    // evenBetterToml doesn't currently support vscode macro substitution
    // once https://github.com/tamasfe/taplo/issues/758 is resolved, use ${workspaceFolder}/taplo.toml for robustness
    "evenBetterToml.taplo.configFile.path": "taplo.toml",
    "python-envs.defaultEnvManager": "ms-python.python:venv",
    "python-envs.defaultPackageManager": "ms-python.python:pip",
}